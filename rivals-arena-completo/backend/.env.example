PORT=3000

# Supabase: painel > Settings > API Keys (veja o GUIA_BANCO_DE_DADOS.md)
SUPABASE_URL=https://seu-projeto-id.supabase.co

# Chave PÚBLICA: "Publishable key" (sb_publishable_...) ou a antiga "anon".
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Chave SECRETA: "Secret key" (sb_secret_...) ou a antiga "service_role".
# NUNCA coloque no frontend nem suba para o GitHub.
SUPABASE_SECRET_KEY=sb_secret_...
